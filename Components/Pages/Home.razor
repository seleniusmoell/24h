@page "/"
@implements IDisposable
@using _24hKlimatet.Models
@using _24hKlimatet.Services
@inject ScheduleService _schedule

<PageTitle>24h Klimatet – Schema</PageTitle>

<div class="home-wrapper">

    <section class="now-section">
        <div class="now-inner">
            @{
                var currents = _schedule.GetAllCurrent(_now);
                var upcomingGroups = _schedule.GetUpcomingGroups(_now, 2).ToList();
            }

            @if (currents.Count > 0)
            {
                <div class="now-current">
                    <div class="now-label">
                        <span class="live-dot"></span>
                        Händer nu
                    </div>
                    @if (currents.Count == 1)
                    {
                        var current = currents[0];
                        <div class="now-card now-card--active">
                            @if (current.ImageUrl is not null)
                            {
                                <img class="now-image" src="@current.ImageUrl" alt="" />
                            }
                            <div class="session-type-badge badge--@current.Type.ToString().ToLower()">@SessionTypeLabel(current.Type)</div>
                            <h2 class="now-title">@current.Title</h2>
                            @if (current.Subtitle is not null)
                            {
                                <p class="now-subtitle">@current.Subtitle</p>
                            }
                            @if (current.Description is not null)
                            {
                                <p class="now-description">@current.Description</p>
                            }
                            <div class="now-meta">
                                @if (current.Speaker is not null)
                                {
                                    <span class="meta-item">@current.Speaker</span>
                                }
                                @if (current.Location is not null)
                                {
                                    <span class="meta-item meta-location">@current.Location</span>
                                }
                                <span class="meta-item meta-time">@current.Start.ToString("HH:mm") – @current.End.ToString("HH:mm")</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="now-parallel">
                            @foreach (var current in currents)
                            {
                                <div class="now-card now-card--active now-card--parallel">
                                    <div class="session-type-badge badge--@current.Type.ToString().ToLower()">@SessionTypeLabel(current.Type)</div>
                                    <h3 class="now-title now-title--sm">@current.Title</h3>
                                    @if (current.Subtitle is not null)
                                    {
                                        <p class="now-subtitle">@current.Subtitle</p>
                                    }
                                    <div class="now-meta">
                                        @if (current.Speaker is not null)
                                        {
                                            <span class="meta-item">@current.Speaker</span>
                                        }
                                        @if (current.Location is not null)
                                        {
                                            <span class="meta-item meta-location">@current.Location</span>
                                        }
                                        <span class="meta-item meta-time">@current.Start.ToString("HH:mm") – @current.End.ToString("HH:mm")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="now-empty">
                    <div class="now-label">Schema</div>
                    <p>Inget pass pågår just nu.</p>
                </div>
            }

            @if (upcomingGroups.Count > 0)
            {
                <div class="upcoming-section">
                    <div class="upcoming-label">Kommer härnäst</div>
                    <div class="upcoming-list">
                        @foreach (var group in upcomingGroups)
                        {
                            @foreach (var item in group)
                            {
                                <div class="now-card now-card--upcoming">
                                    <div class="session-type-badge badge--@item.Type.ToString().ToLower()">@SessionTypeLabel(item.Type)</div>
                                    <div class="upcoming-time">@item.Start.ToString("HH:mm")</div>
                                    <div class="upcoming-title">@item.Title</div>
                                    @if (item.Location is not null)
                                    {
                                        <div class="upcoming-location">@item.Location</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    @{
        var allDay = _schedule.GetAllDay();
    }
    @if (allDay.Count > 0)
    {
        <section class="allday-section">
            <h2 class="allday-heading">Öppet hela dygnet</h2>
            <div class="allday-list">
                @foreach (var item in allDay)
                {
                    <div class="allday-card" @onclick="() => OpenDetail(item)">
                        @if (item.ImageUrl is not null)
                        {
                            <img class="allday-thumb" src="@item.ImageUrl" alt="" />
                        }
                        <div class="session-type-badge badge--@item.Type.ToString().ToLower()">@SessionTypeLabel(item.Type)</div>
                        <div class="allday-title">@item.Title</div>
                        @if (item.Subtitle is not null && item.Subtitle != "")
                        {
                            <div class="allday-subtitle">@item.Subtitle</div>
                        }
                        @if (item.Location is not null)
                        {
                            <div class="allday-location">@item.Location</div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    <section class="schedule-section">
        <h2 class="schedule-heading">Hela schemat</h2>
        <div class="schedule-list">
            @foreach (var group in _schedule.GetGrouped())
            {
                var isParallel  = group.Count > 1;
                var isAnyActive = group.Any(s => s.IsActive(_now));
                var isAllPast   = group.All(s => s.IsPast(_now));
                var groupClass  = isAnyActive && !isParallel ? "schedule-group schedule-group--has-active"
                                : isAllPast                  ? "schedule-group schedule-group--past"
                                                             : "schedule-group";
                <div class="@groupClass">
                    <div class="schedule-time">
                        <span class="time-start">@group.Min(s => s.Start).ToString("HH:mm")</span>
                        <span class="time-end">@group.Max(s => s.End).ToString("HH:mm")</span>
                    </div>
                    <div class="schedule-items @(isParallel ? "schedule-items--parallel" : "")">
                        @foreach (var item in group)
                        {
                            var isItemActive = item.IsActive(_now);
                            var isItemPast   = item.IsPast(_now);
                            var itemClass    = isParallel && isItemActive ? "schedule-item schedule-item--active"
                                            : isParallel && isItemPast   ? "schedule-item schedule-item--past"
                                                                         : "schedule-item";
                            <div class="@itemClass" @onclick="() => OpenDetail(item)">
                                <div class="schedule-body">
                                    @if (item.ImageUrl is not null)
                                    {
                                        <img class="schedule-thumb" src="@item.ImageUrl" alt="" />
                                    }
                                    <div class="schedule-text">
                                        <div class="schedule-type-badge badge--@item.Type.ToString().ToLower()">@SessionTypeLabel(item.Type)</div>
                                        <div class="schedule-title">@item.Title</div>
                                        @if (item.Subtitle is not null)
                                        {
                                            <div class="schedule-subtitle">@item.Subtitle</div>
                                        }
                                        <div class="schedule-meta">
                                            @if (item.Speaker is not null)
                                            {
                                                <span>@item.Speaker</span>
                                            }
                                            @if (item.Location is not null)
                                            {
                                                <span class="meta-location">@item.Location</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @if (isItemActive)
                                {
                                    <div class="schedule-active-indicator">
                                        <span class="live-dot live-dot--small"></span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

</div>

@if (_selectedItem is not null)
{
    <div class="modal-overlay" @onclick="CloseDetail">
        <div class="modal-card" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseDetail" aria-label="Stäng">✕</button>
            @if (_selectedItem.ImageUrl is not null)
            {
                <img class="modal-image" src="@_selectedItem.ImageUrl" alt="" />
            }
            <div class="modal-body">
                <div class="session-type-badge badge--@_selectedItem.Type.ToString().ToLower()">@SessionTypeLabel(_selectedItem.Type)</div>
                <h2 class="modal-title">@_selectedItem.Title</h2>
                @if (_selectedItem.Subtitle is not null)
                {
                    <p class="modal-subtitle">@_selectedItem.Subtitle</p>
                }
                @if (_selectedItem.Description is not null)
                {
                    <p class="modal-description">@_selectedItem.Description</p>
                }
                <div class="modal-meta">
                    @if (_selectedItem.Speaker is not null)
                    {
                        <span class="modal-meta-item">@_selectedItem.Speaker</span>
                    }
                    @if (_selectedItem.Location is not null)
                    {
                        <span class="modal-meta-item modal-meta-location">@_selectedItem.Location</span>
                    }
                    <span class="modal-meta-item modal-meta-time">@_selectedItem.Start.ToString("HH:mm") – @_selectedItem.End.ToString("HH:mm")</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime _now = DateTime.Now;
    private Timer? _timer;
    private ScheduleItem? _selectedItem;

    private void OpenDetail(ScheduleItem item) => _selectedItem = item;
    private void CloseDetail() => _selectedItem = null;

    protected override void OnInitialized()
    {
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            _now = DateTime.Now;
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose() => _timer?.Dispose();

    private static string SessionTypeLabel(SessionType type) => type switch
    {
        SessionType.Opening     => "Öppning",
        SessionType.Talk        => "Föredrag",
        SessionType.Panel       => "Panel",
        SessionType.Workshop    => "Workshop",
        SessionType.Break       => "Paus",
        SessionType.Performance => "Föreställning",
        SessionType.Demonstration => "Demonstration",
        SessionType.Exhibition    => "Utställning",
        _                         => type.ToString()
    };
}
